{
  "name": "@smoothsdlc/smooth-backlog-cli",
  "version": "0.0.0-development",
  "private": true,
  "description": "Keep your backlog beside your code. Manage branch-specific work, priorities, and progress from the CLI, with built-in skills for developers and coding agents.",
  "type": "module",
  "bin": {
    "backlog": "bin/backlog.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "SmoothSDLC Systems Inc (https://SmoothSDLC.com)",
  "homepage": "https://github.com/SmoothSDLC/smooth-backlog-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmoothSDLC/smooth-backlog-cli.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "COMMANDS.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test .agents/test/*.test.js",
    "check": "node --check bin/backlog.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "backlogSchemaVersion": 1,
  "backlogRuntimeVersion": 1
}
