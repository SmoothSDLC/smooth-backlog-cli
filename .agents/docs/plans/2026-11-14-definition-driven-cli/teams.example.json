{
  "simple": {
    "description": "One agent works through the queue one item at a time. An item is small (at most 120 minutes), is started, then finished with a written result.",
    "people": {
      "agent-1": [
        "worker"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "todo",
        "values": [
          "todo",
          "doing",
          "done"
        ],
        "final": [
          "done"
        ],
        "description": "Where the item is."
      },
      "estimate": {
        "type": "number",
        "default": 0,
        "description": "Minutes of work."
      },
      "result": {
        "type": "text",
        "default": "",
        "description": "What was delivered."
      }
    },
    "rules": {
      "description": "Only the team's agent changes items. A new item needs an estimate of at most 120 minutes. Status moves todo to doing to done. One item is doing at a time. Done needs a result.",
      "rules": [
        {
          "id": 1,
          "description": "only people of the team",
          "require": {
            "not": {
              "empty": "$caller.roles"
            }
          },
          "message": "{$caller} is not a person of team {$team.name}"
        },
        {
          "id": 2,
          "on": {
            "commands": [
              "new"
            ]
          },
          "require": {
            "all": [
              {
                ">": [
                  "$after.estimate",
                  0
                ]
              },
              {
                "<=": [
                  "$after.estimate",
                  120
                ]
              }
            ]
          },
          "message": "a new item needs --estimate between 1 and 120 minutes (got {$after.estimate}); split larger work"
        },
        {
          "id": 3,
          "on": {
            "changes": [
              "status"
            ]
          },
          "require": {
            "any": [
              {
                "all": [
                  {
                    "is": [
                      "$before.status",
                      "todo"
                    ]
                  },
                  {
                    "is": [
                      "$after.status",
                      "doing"
                    ]
                  }
                ]
              },
              {
                "all": [
                  {
                    "is": [
                      "$before.status",
                      "doing"
                    ]
                  },
                  {
                    "is": [
                      "$after.status",
                      "done"
                    ]
                  }
                ]
              }
            ]
          },
          "message": "status moves todo to doing to done, not {$before.status} to {$after.status}"
        },
        {
          "id": 4,
          "on": {
            "to": {
              "status": [
                "doing"
              ]
            }
          },
          "require": {
            "<=": [
              {
                "count": {
                  "items": "$team.items",
                  "match": {
                    "is": [
                      "$it.status",
                      "doing"
                    ]
                  }
                }
              },
              1
            ]
          },
          "message": "finish the item in progress first"
        },
        {
          "id": 5,
          "on": {
            "to": {
              "status": [
                "done"
              ]
            }
          },
          "require": {
            "not": {
              "empty": "$after.result"
            }
          },
          "message": "done needs a result: backlog team update {$after.seq} result \"<what was delivered>\""
        },
        {
          "id": 6,
          "on": {
            "commands": [
              "archive"
            ]
          },
          "require": {
            "is": [
              "$after.status",
              "done"
            ]
          },
          "message": "only a done item is archived"
        }
      ],
      "queue": [
        {
          "description": "the next item to start",
          "match": {
            "is": [
              "$it.status",
              "todo"
            ]
          },
          "take": {
            "status": "doing"
          }
        }
      ],
      "filters": {
        "doing": {
          "description": "The item in progress.",
          "match": {
            "is": [
              "$it.status",
              "doing"
            ]
          }
        }
      }
    }
  },
  "advanced": {
    "description": "A lead and three members. The lead splits large work into items of at most 60 minutes. A member takes a ready item whose dependencies are closed, works on it, and another member checks it before it closes.",
    "people": {
      "lead-1": [
        "lead"
      ],
      "member-1": [
        "member"
      ],
      "member-2": [
        "member"
      ],
      "member-3": [
        "member"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "new",
        "values": [
          "new",
          "ready",
          "active",
          "checking",
          "closed"
        ],
        "final": [
          "closed"
        ],
        "description": "Where the item is in the team's flow."
      },
      "estimate": {
        "type": "number",
        "default": 0,
        "description": "Minutes of work, check included."
      },
      "holder": {
        "type": "person",
        "default": "",
        "description": "The member working on the item."
      },
      "checker": {
        "type": "person",
        "default": "",
        "description": "The member checking the holder's work."
      },
      "parent": {
        "type": "item",
        "default": null,
        "description": "The item this one was split from."
      },
      "depends_on": {
        "type": "items",
        "default": [],
        "description": "Items that must be closed before this one becomes active."
      },
      "result": {
        "type": "text",
        "default": "",
        "description": "What was delivered."
      }
    },
    "rules": {
      "description": "Only people of the team change items; only the lead creates and readies them. Items are at most 60 minutes. Status moves new, ready, active, checking, closed, and checking may go back to active. Becoming active makes the caller the holder and needs every dependency closed; a member holds one active item. Checking needs a result and a checker who is not the holder. Only the checker closes.",
      "conditions": {
        "dependencies-closed": {
          "every": {
            "items": {
              "$items": "$after.depends_on"
            },
            "match": {
              "is": [
                "$it.status",
                "closed"
              ]
            }
          }
        }
      },
      "rules": [
        {
          "id": "members",
          "require": {
            "not": {
              "empty": "$caller.roles"
            }
          },
          "message": "{$caller} is not a person of team {$team.name}"
        },
        {
          "id": "lead-creates",
          "on": {
            "commands": [
              "new"
            ]
          },
          "require": {
            "in": [
              "lead",
              "$caller.roles"
            ]
          },
          "message": "only a lead creates items"
        },
        {
          "id": "size",
          "require": {
            "<=": [
              "$after.estimate",
              60
            ]
          },
          "message": "an item is at most 60 minutes (got {$after.estimate}); split it into children with parent {$after.seq}"
        },
        {
          "id": "flow",
          "on": {
            "changes": [
              "status"
            ]
          },
          "require": {
            "in": [
              {
                "text": "{$before.status}>{$after.status}"
              },
              [
                "new>ready",
                "ready>active",
                "active>checking",
                "checking>active",
                "checking>closed"
              ]
            ]
          },
          "message": "status does not move from {$before.status} to {$after.status}"
        },
        {
          "id": "lead-readies",
          "on": {
            "to": {
              "status": [
                "ready"
              ]
            }
          },
          "require": {
            "in": [
              "lead",
              "$caller.roles"
            ]
          },
          "message": "only a lead marks an item ready"
        },
        {
          "id": "take",
          "on": {
            "to": {
              "status": [
                "active"
              ]
            },
            "from": {
              "status": [
                "ready"
              ]
            }
          },
          "set": {
            "holder": "$caller"
          }
        },
        {
          "id": "ready-to-start",
          "on": {
            "to": {
              "status": [
                "active"
              ]
            }
          },
          "require": {
            "condition": "dependencies-closed"
          },
          "message": "item {$after.seq} waits for the items it depends on"
        },
        {
          "id": "one-each",
          "on": {
            "to": {
              "status": [
                "active"
              ]
            }
          },
          "require": {
            "<=": [
              {
                "count": {
                  "items": "$team.items",
                  "match": {
                    "all": [
                      {
                        "is": [
                          "$it.status",
                          "active"
                        ]
                      },
                      {
                        "is": [
                          "$it.holder",
                          "$caller"
                        ]
                      }
                    ]
                  }
                }
              },
              1
            ]
          },
          "message": "{$caller} already holds an active item"
        },
        {
          "id": "check-needs",
          "on": {
            "to": {
              "status": [
                "checking"
              ]
            }
          },
          "require": {
            "all": [
              {
                "not": {
                  "empty": "$after.result"
                }
              },
              {
                "not": {
                  "empty": "$after.checker"
                }
              },
              {
                "not": {
                  "is": [
                    "$after.checker",
                    "$after.holder"
                  ]
                }
              }
            ]
          },
          "message": "checking needs a result and a checker other than the holder"
        },
        {
          "id": "checker-closes",
          "on": {
            "to": {
              "status": [
                "closed"
              ]
            }
          },
          "require": {
            "is": [
              "$caller",
              "$after.checker"
            ]
          },
          "message": "only the checker {$after.checker} closes item {$after.seq}"
        },
        {
          "id": "archive-closed",
          "on": {
            "commands": [
              "archive"
            ]
          },
          "require": {
            "is": [
              "$after.status",
              "closed"
            ]
          },
          "message": "only a closed item is archived"
        }
      ],
      "queue": [
        {
          "roles": [
            "member"
          ],
          "description": "a member checks first, then takes ready work",
          "match": {
            "all": [
              {
                "is": [
                  "$it.status",
                  "checking"
                ]
              },
              {
                "is": [
                  "$it.checker",
                  "$caller"
                ]
              }
            ]
          }
        },
        {
          "roles": [
            "member"
          ],
          "match": {
            "all": [
              {
                "is": [
                  "$it.status",
                  "ready"
                ]
              },
              {
                "every": {
                  "items": {
                    "$items": "$it.depends_on"
                  },
                  "match": {
                    "is": [
                      "$it.status",
                      "closed"
                    ]
                  }
                }
              }
            ]
          },
          "take": {
            "status": "active"
          }
        }
      ],
      "filters": {
        "waiting": {
          "description": "Ready items that wait for a dependency.",
          "match": {
            "all": [
              {
                "is": [
                  "$it.status",
                  "ready"
                ]
              },
              {
                "some": {
                  "items": {
                    "$items": "$it.depends_on"
                  },
                  "match": {
                    "not": {
                      "is": [
                        "$it.status",
                        "closed"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "lead-and-reviewers": {
    "description": "A lead plans and splits work; members implement; every item passes a review by a reviewer and then a second review by an outside reviewer before the lead closes it. A member can hand an item over to another member, and an item can wait for a decision of the lead.",
    "people": {
      "lead-1": [
        "lead"
      ],
      "member-1": [
        "member"
      ],
      "member-2": [
        "member"
      ],
      "reviewer-1": [
        "reviewer"
      ],
      "outside-1": [
        "outside-reviewer"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "new",
        "values": [
          "new",
          "ready",
          "active",
          "review",
          "second-review",
          "waiting",
          "closed"
        ],
        "final": [
          "closed"
        ],
        "description": "Where the item is."
      },
      "estimate": {
        "type": "number",
        "default": 0,
        "description": "Minutes of work."
      },
      "done_when": {
        "type": "text",
        "default": "",
        "description": "What must be true for the item to be finished."
      },
      "holder": {
        "type": "person",
        "default": "",
        "description": "The member working on the item."
      },
      "reviewer": {
        "type": "person",
        "default": "",
        "description": "Who reviews the item now."
      },
      "review_passes": {
        "type": "number",
        "default": 0,
        "description": "How many reviews the item has passed."
      },
      "handoff_to": {
        "type": "person",
        "default": "",
        "description": "The member the item is handed to."
      },
      "question": {
        "type": "text",
        "default": "",
        "description": "The decision the item waits for."
      },
      "depends_on": {
        "type": "items",
        "default": [],
        "description": "Items that must be closed first."
      },
      "result": {
        "type": "text",
        "default": "",
        "description": "What was delivered."
      }
    },
    "rules": {
      "description": "See the team description. Every rule below either refuses a change with its message or sets values that follow from a change.",
      "conditions": {
        "lead": {
          "in": [
            "lead",
            "$caller.roles"
          ]
        },
        "holder": {
          "is": [
            "$caller",
            "$after.holder"
          ]
        }
      },
      "rules": [
        {
          "id": 1,
          "require": {
            "not": {
              "empty": "$caller.roles"
            }
          },
          "message": "{$caller} is not a person of team {$team.name}"
        },
        {
          "id": 2,
          "on": {
            "commands": [
              "new"
            ]
          },
          "require": {
            "all": [
              {
                "condition": "lead"
              },
              {
                "not": {
                  "empty": "$after.done_when"
                }
              }
            ]
          },
          "message": "a lead creates an item, with --done_when"
        },
        {
          "id": 3,
          "on": {
            "changes": [
              "status"
            ]
          },
          "require": {
            "in": [
              {
                "text": "{$before.status}>{$after.status}"
              },
              [
                "new>ready",
                "ready>active",
                "active>review",
                "review>active",
                "review>second-review",
                "second-review>active",
                "second-review>closed",
                "active>waiting",
                "waiting>active"
              ]
            ]
          },
          "message": "status does not move from {$before.status} to {$after.status}"
        },
        {
          "id": 4,
          "on": {
            "to": {
              "status": [
                "ready",
                "closed"
              ]
            }
          },
          "require": {
            "condition": "lead"
          },
          "message": "only a lead marks an item {$after.status}"
        },
        {
          "id": 5,
          "on": {
            "from": {
              "status": [
                "ready"
              ]
            },
            "to": {
              "status": [
                "active"
              ]
            }
          },
          "set": {
            "holder": "$caller"
          }
        },
        {
          "id": 6,
          "on": {
            "to": {
              "status": [
                "active"
              ]
            }
          },
          "require": {
            "every": {
              "items": {
                "$items": "$after.depends_on"
              },
              "match": {
                "is": [
                  "$it.status",
                  "closed"
                ]
              }
            }
          },
          "message": "item {$after.seq} waits for its dependencies"
        },
        {
          "id": 7,
          "on": {
            "to": {
              "status": [
                "review"
              ]
            }
          },
          "require": {
            "all": [
              {
                "condition": "holder"
              },
              {
                "not": {
                  "empty": "$after.result"
                }
              },
              {
                "in": [
                  "reviewer",
                  {
                    "roles_of": "$after.reviewer"
                  }
                ]
              }
            ]
          },
          "message": "the holder asks for review with a result and a reviewer"
        },
        {
          "id": 8,
          "on": {
            "to": {
              "status": [
                "second-review"
              ]
            }
          },
          "require": {
            "all": [
              {
                "is": [
                  "$caller",
                  "$before.reviewer"
                ]
              },
              {
                "in": [
                  "outside-reviewer",
                  {
                    "roles_of": "$after.reviewer"
                  }
                ]
              }
            ]
          },
          "message": "the reviewer passes the item to an outside reviewer"
        },
        {
          "id": 9,
          "on": {
            "from": {
              "status": [
                "review",
                "second-review"
              ]
            },
            "to": {
              "status": [
                "second-review",
                "closed"
              ]
            }
          },
          "set": {
            "review_passes": {
              "plus": [
                "$before.review_passes",
                1
              ]
            }
          }
        },
        {
          "id": 10,
          "on": {
            "to": {
              "status": [
                "closed"
              ]
            }
          },
          "require": {
            ">=": [
              "$after.review_passes",
              2
            ]
          },
          "message": "an item closes after two reviews (passed {$after.review_passes})"
        },
        {
          "id": 11,
          "on": {
            "changes": [
              "handoff_to"
            ]
          },
          "require": {
            "all": [
              {
                "is": [
                  "$caller",
                  "$before.holder"
                ]
              },
              {
                "in": [
                  "member",
                  {
                    "roles_of": "$after.handoff_to"
                  }
                ]
              }
            ]
          },
          "message": "the holder hands an item to another member"
        },
        {
          "id": 12,
          "on": {
            "changes": [
              "handoff_to"
            ]
          },
          "set": {
            "holder": "$after.handoff_to"
          }
        },
        {
          "id": 13,
          "on": {
            "to": {
              "status": [
                "waiting"
              ]
            }
          },
          "require": {
            "not": {
              "empty": "$after.question"
            }
          },
          "message": "an item waits with the question it waits for"
        },
        {
          "id": 14,
          "on": {
            "from": {
              "status": [
                "waiting"
              ]
            }
          },
          "require": {
            "condition": "lead"
          },
          "message": "only a lead answers the question of a waiting item"
        },
        {
          "id": 15,
          "require": {
            "<=": [
              "$after.estimate",
              90
            ]
          },
          "message": "an item is at most 90 minutes (got {$after.estimate})"
        },
        {
          "id": 16,
          "on": {
            "commands": [
              "archive"
            ]
          },
          "require": {
            "is": [
              "$after.status",
              "closed"
            ]
          },
          "message": "only a closed item is archived"
        }
      ],
      "queue": [
        {
          "roles": [
            "reviewer",
            "outside-reviewer"
          ],
          "description": "a reviewer takes what waits for its review",
          "match": {
            "all": [
              {
                "in": [
                  "$it.status",
                  [
                    "review",
                    "second-review"
                  ]
                ]
              },
              {
                "is": [
                  "$it.reviewer",
                  "$caller"
                ]
              }
            ]
          }
        },
        {
          "roles": [
            "member"
          ],
          "description": "a member takes ready work",
          "match": {
            "is": [
              "$it.status",
              "ready"
            ]
          },
          "take": {
            "status": "active"
          }
        },
        {
          "roles": [
            "lead"
          ],
          "description": "the lead answers waiting items first, then readies new ones",
          "match": {
            "in": [
              "$it.status",
              [
                "waiting",
                "new"
              ]
            ]
          }
        }
      ],
      "filters": {
        "decisions": {
          "description": "Items waiting for the lead.",
          "match": {
            "is": [
              "$it.status",
              "waiting"
            ]
          }
        },
        "in-review": {
          "description": "Items in either review.",
          "match": {
            "in": [
              "$it.status",
              [
                "review",
                "second-review"
              ]
            ]
          }
        }
      }
    }
  }
}