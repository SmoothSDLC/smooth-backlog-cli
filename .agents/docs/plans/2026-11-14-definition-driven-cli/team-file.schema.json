{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmoothSDLC/smooth-backlog-cli/team-file.schema.json",
  "title": "The team file",
  "description": "One entry per team: its people, its item definition and its rule set. The CLI only reads this file.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "$ref": "#/$defs/team"
  },
  "$defs": {
    "team": {
      "type": "object",
      "required": [
        "people",
        "item",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "people": {
          "type": "object",
          "description": "Each person of the team with the list of role words the rules use.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "item": {
          "$ref": "#/$defs/itemDefinition"
        },
        "rules": {
          "$ref": "team-rules.schema.json",
          "description": "The team's rule set; its form is team-rules.schema.json and its meaning team-rules-spec.md."
        },
        "description": {
          "type": "string",
          "description": "The team's way of working in words."
        }
      }
    },
    "itemDefinition": {
      "type": "object",
      "description": "The fields of an item beyond the base item. The same form is used by the definition packaged with the CLI and by a repository's default definition.",
      "required": [
        "status"
      ],
      "propertyNames": {
        "not": {
          "enum": [
            "seq",
            "slug",
            "title",
            "description",
            "team",
            "repository",
            "branch",
            "created",
            "updated",
            "updated_by",
            "cli_version",
            "history"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "field": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "time",
            "person",
            "item",
            "items",
            "list"
          ]
        },
        "default": {},
        "values": {
          "type": "array",
          "description": "The allowed values, when the field has a closed list."
        },
        "final": {
          "type": "array",
          "description": "The values that mean the item is finished (status only)."
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}