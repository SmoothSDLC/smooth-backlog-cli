{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:backlog:team-definition:2",
 "title": "input file of backlog team define",
 "type": "object",
 "required": [
  "schema",
  "name",
  "workflow",
  "people"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "backlog-team-definition/2"
  },
  "name": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9:_-]{0,63}$"
  },
  "workflow": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
  },
  "people": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]{0,39}$"
   },
   "additionalProperties": {
    "type": "string",
    "pattern": "^\\S(.*\\S)?$"
   },
   "minProperties": 1
  },
  "lists": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]{0,39}$"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^\\S(.*\\S)?$"
    },
    "uniqueItems": true
   }
  },
  "rules": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]{0,39}$"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "team",
      "count"
     ],
     "additionalProperties": false,
     "properties": {
      "team": {
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9:_-]{0,63}$"
      },
      "count": {
       "type": "integer",
       "minimum": 1
      }
     }
    }
   }
  },
  "review": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
     },
     "count": {
      "type": "integer",
      "minimum": 1
     },
     "team": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_-]{0,63}$"
     }
    },
    "required": [
     "stage",
     "count"
    ],
    "additionalProperties": false
   }
  },
  "limits": {
   "type": "object",
   "properties": {
    "overall": {
     "type": "integer",
     "minimum": 0
    },
    "repository": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0
      },
      {
       "type": "object",
       "propertyNames": {
        "type": "string",
        "minLength": 1
       },
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       },
       "minProperties": 1
      }
     ]
    },
    "branch": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0
      },
      {
       "type": "object",
       "propertyNames": {
        "type": "string",
        "minLength": 1
       },
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       },
       "minProperties": 1
      }
     ]
    },
    "team": {
     "type": "integer",
     "minimum": 0
    },
    "member": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0
      },
      {
       "type": "object",
       "propertyNames": {
        "type": "string",
        "minLength": 1
       },
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       },
       "minProperties": 1
      }
     ]
    }
   },
   "additionalProperties": false
  },
  "chunk_scope": {
   "enum": [
    "off",
    "branch",
    "repo",
    "all"
   ]
  }
 }
}
