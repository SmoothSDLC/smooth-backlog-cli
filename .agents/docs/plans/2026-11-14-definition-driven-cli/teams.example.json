{
  "simple": {
    "description": "One agent works through the queue one item at a time. An item is small (at most 120 minutes), is started, then finished with a written result.",
    "people": {
      "agent-1": [
        "worker"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "todo",
        "values": [
          "todo",
          "doing",
          "done"
        ],
        "final": [
          "done"
        ],
        "description": "Where the item is."
      },
      "estimate": {
        "type": "number",
        "default": 0,
        "description": "Minutes of work."
      },
      "result": {
        "type": "text",
        "default": "",
        "description": "What was delivered."
      }
    },
    "rules": {
      "description": "Only the team's agent changes items. A new item needs an estimate of 1 to 120 minutes. Status moves todo to doing to done. One item is doing at a time. Done needs a result. Only a done item is archived.",
      "rules": [
        {
          "id": 1,
          "require": {
            "!!": {
              "var": "caller.roles"
            }
          },
          "error": "{caller.name} is not a person of team {team.name}"
        },
        {
          "id": 2,
          "when": {
            "===": [
              {
                "var": "command"
              },
              "new"
            ]
          },
          "require": {
            "and": [
              {
                ">": [
                  {
                    "var": "next.estimate"
                  },
                  0
                ]
              },
              {
                "<=": [
                  {
                    "var": "next.estimate"
                  },
                  120
                ]
              }
            ]
          },
          "error": "a new item needs --estimate between 1 and 120 minutes (got {next.estimate}); split larger work"
        },
        {
          "id": 3,
          "when": {
            "changed": "status"
          },
          "require": {
            "in": [
              {
                "cat": [
                  {
                    "var": "prev.status"
                  },
                  ">",
                  {
                    "var": "next.status"
                  }
                ]
              },
              [
                "todo>doing",
                "doing>done"
              ]
            ]
          },
          "error": "status does not move from {prev.status} to {next.status}"
        },
        {
          "id": 4,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "doing"
                ]
              }
            ]
          },
          "require": {
            "<=": [
              {
                "length": {
                  "filter": [
                    {
                      "var": "team.items"
                    },
                    {
                      "===": [
                        {
                          "var": "status"
                        },
                        "doing"
                      ]
                    }
                  ]
                }
              },
              1
            ]
          },
          "error": "finish the item in progress first"
        },
        {
          "id": 5,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "done"
                ]
              }
            ]
          },
          "require": {
            "!!": {
              "var": "next.result"
            }
          },
          "error": "done needs a result: backlog team update {next.seq} result \"<what was delivered>\""
        },
        {
          "id": 6,
          "when": {
            "===": [
              {
                "var": "command"
              },
              "archive"
            ]
          },
          "require": {
            "===": [
              {
                "var": "next.status"
              },
              "done"
            ]
          },
          "error": "only a done item is archived"
        }
      ],
      "queue": [
        {
          "description": "the next item to start",
          "match": {
            "===": [
              {
                "var": "status"
              },
              "todo"
            ]
          },
          "take": {
            "status": "doing"
          }
        }
      ],
      "filters": {
        "doing": {
          "description": "The item in progress.",
          "match": {
            "===": [
              {
                "var": "status"
              },
              "doing"
            ]
          }
        }
      }
    }
  },
  "advanced": {
    "description": "A lead and three members. The lead creates and readies items of at most 60 minutes, splitting larger work into children. A member takes a ready item whose dependencies are closed by setting itself as holder and the status active, holds one active item at a time, and names another member as checker when asking for a check; only the checker closes.",
    "people": {
      "lead-1": [
        "lead"
      ],
      "member-1": [
        "member"
      ],
      "member-2": [
        "member"
      ],
      "member-3": [
        "member"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "new",
        "values": [
          "new",
          "ready",
          "active",
          "checking",
          "closed"
        ],
        "final": [
          "closed"
        ],
        "description": "Where the item is in the team's flow."
      },
      "estimate": {
        "type": "number",
        "default": 0,
        "description": "Minutes of work, check included."
      },
      "holder": {
        "type": "person",
        "default": "",
        "description": "The member working on the item."
      },
      "checker": {
        "type": "person",
        "default": "",
        "description": "The member checking the holder's work."
      },
      "parent": {
        "type": "item",
        "default": null,
        "description": "The item this one was split from."
      },
      "depends_on": {
        "type": "items",
        "default": [],
        "description": "Items that must be closed before this one becomes active."
      },
      "result": {
        "type": "text",
        "default": "",
        "description": "What was delivered."
      }
    },
    "rules": {
      "description": "See the team description; each rule refuses one kind of change.",
      "rules": [
        {
          "id": "members",
          "require": {
            "!!": {
              "var": "caller.roles"
            }
          },
          "error": "{caller.name} is not a person of team {team.name}"
        },
        {
          "id": "lead-creates",
          "when": {
            "===": [
              {
                "var": "command"
              },
              "new"
            ]
          },
          "require": {
            "in": [
              "lead",
              {
                "var": "caller.roles"
              }
            ]
          },
          "error": "only a lead creates items"
        },
        {
          "id": "size",
          "require": {
            "<=": [
              {
                "var": "next.estimate"
              },
              60
            ]
          },
          "error": "an item is at most 60 minutes (got {next.estimate}); split it into children with parent {next.seq}"
        },
        {
          "id": "flow",
          "when": {
            "changed": "status"
          },
          "require": {
            "in": [
              {
                "cat": [
                  {
                    "var": "prev.status"
                  },
                  ">",
                  {
                    "var": "next.status"
                  }
                ]
              },
              [
                "new>ready",
                "ready>active",
                "active>checking",
                "checking>active",
                "checking>closed"
              ]
            ]
          },
          "error": "status does not move from {prev.status} to {next.status}"
        },
        {
          "id": "lead-readies",
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "ready"
                ]
              }
            ]
          },
          "require": {
            "in": [
              "lead",
              {
                "var": "caller.roles"
              }
            ]
          },
          "error": "only a lead marks an item ready"
        },
        {
          "id": "holder-is-caller",
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "active"
                ]
              }
            ]
          },
          "require": {
            "===": [
              {
                "var": "next.holder"
              },
              {
                "var": "caller.name"
              }
            ]
          },
          "error": "set yourself as holder before making item {next.seq} active"
        },
        {
          "id": "dependencies",
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "active"
                ]
              }
            ]
          },
          "require": {
            "all": [
              {
                "map": [
                  {
                    "var": "next.depends_on"
                  },
                  {
                    "item": {
                      "var": ""
                    }
                  }
                ]
              },
              {
                "===": [
                  {
                    "var": "status"
                  },
                  "closed"
                ]
              }
            ]
          },
          "error": "item {next.seq} waits for the items it depends on"
        },
        {
          "id": "one-each",
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "active"
                ]
              }
            ]
          },
          "require": {
            "<=": [
              {
                "length": {
                  "filter": [
                    {
                      "var": "team.items"
                    },
                    {
                      "and": [
                        {
                          "===": [
                            {
                              "var": "status"
                            },
                            "active"
                          ]
                        },
                        {
                          "===": [
                            {
                              "var": "holder"
                            },
                            {
                              "outer": "caller.name"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              1
            ]
          },
          "error": "{caller.name} already holds an active item"
        },
        {
          "id": "holder-locked",
          "when": {
            "and": [
              {
                "===": [
                  {
                    "var": "prev.status"
                  },
                  "active"
                ]
              },
              {
                "changed": "holder"
              }
            ]
          },
          "require": false,
          "error": "the holder of an active item does not change"
        },
        {
          "id": "check-needs",
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "checking"
                ]
              }
            ]
          },
          "require": {
            "and": [
              {
                "!!": {
                  "var": "next.result"
                }
              },
              {
                "!!": {
                  "var": "next.checker"
                }
              },
              {
                "!==": [
                  {
                    "var": "next.checker"
                  },
                  {
                    "var": "next.holder"
                  }
                ]
              }
            ]
          },
          "error": "checking needs a result and a checker other than the holder"
        },
        {
          "id": "checker-closes",
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "closed"
                ]
              }
            ]
          },
          "require": {
            "===": [
              {
                "var": "caller.name"
              },
              {
                "var": "next.checker"
              }
            ]
          },
          "error": "only the checker {next.checker} closes item {next.seq}"
        },
        {
          "id": "archive-closed",
          "when": {
            "===": [
              {
                "var": "command"
              },
              "archive"
            ]
          },
          "require": {
            "===": [
              {
                "var": "next.status"
              },
              "closed"
            ]
          },
          "error": "only a closed item is archived"
        }
      ],
      "queue": [
        {
          "roles": [
            "member"
          ],
          "description": "a member's checks first",
          "match": {
            "and": [
              {
                "===": [
                  {
                    "var": "status"
                  },
                  "checking"
                ]
              },
              {
                "===": [
                  {
                    "var": "checker"
                  },
                  {
                    "outer": "caller.name"
                  }
                ]
              }
            ]
          }
        },
        {
          "roles": [
            "member"
          ],
          "description": "then ready work whose dependencies are closed",
          "match": {
            "and": [
              {
                "===": [
                  {
                    "var": "status"
                  },
                  "ready"
                ]
              },
              {
                "all": [
                  {
                    "map": [
                      {
                        "var": "depends_on"
                      },
                      {
                        "item": {
                          "var": ""
                        }
                      }
                    ]
                  },
                  {
                    "===": [
                      {
                        "var": "status"
                      },
                      "closed"
                    ]
                  }
                ]
              }
            ]
          },
          "take": {
            "holder": "$caller",
            "status": "active"
          }
        }
      ],
      "filters": {
        "waiting": {
          "description": "Ready items that wait for a dependency.",
          "match": {
            "and": [
              {
                "===": [
                  {
                    "var": "status"
                  },
                  "ready"
                ]
              },
              {
                "some": [
                  {
                    "map": [
                      {
                        "var": "depends_on"
                      },
                      {
                        "item": {
                          "var": ""
                        }
                      }
                    ]
                  },
                  {
                    "!==": [
                      {
                        "var": "status"
                      },
                      "closed"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "lead-and-reviewers": {
    "description": "A lead plans and readies work; members implement; every item passes a review by a reviewer and then a second review by an outside reviewer before the lead closes it. The holder can hand an item to another member, and an item can wait for a decision of the lead.",
    "people": {
      "lead-1": [
        "lead"
      ],
      "member-1": [
        "member"
      ],
      "member-2": [
        "member"
      ],
      "reviewer-1": [
        "reviewer"
      ],
      "outside-1": [
        "outside-reviewer"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "new",
        "values": [
          "new",
          "ready",
          "active",
          "review",
          "second-review",
          "waiting",
          "closed"
        ],
        "final": [
          "closed"
        ],
        "description": "Where the item is."
      },
      "estimate": {
        "type": "number",
        "default": 0,
        "description": "Minutes of work."
      },
      "done_when": {
        "type": "text",
        "default": "",
        "description": "What must be true for the item to be finished."
      },
      "holder": {
        "type": "person",
        "default": "",
        "description": "The member working on the item."
      },
      "reviewer": {
        "type": "person",
        "default": "",
        "description": "Who reviews the item now."
      },
      "review_passes": {
        "type": "number",
        "default": 0,
        "description": "How many reviews the item has passed; the reviewer raises it by one when passing the item on."
      },
      "question": {
        "type": "text",
        "default": "",
        "description": "The decision the item waits for."
      },
      "depends_on": {
        "type": "items",
        "default": [],
        "description": "Items that must be closed first."
      },
      "result": {
        "type": "text",
        "default": "",
        "description": "What was delivered."
      }
    },
    "rules": {
      "description": "See the team description; each rule refuses one kind of change.",
      "rules": [
        {
          "id": 1,
          "require": {
            "!!": {
              "var": "caller.roles"
            }
          },
          "error": "{caller.name} is not a person of team {team.name}"
        },
        {
          "id": 2,
          "when": {
            "===": [
              {
                "var": "command"
              },
              "new"
            ]
          },
          "require": {
            "and": [
              {
                "in": [
                  "lead",
                  {
                    "var": "caller.roles"
                  }
                ]
              },
              {
                "!!": {
                  "var": "next.done_when"
                }
              }
            ]
          },
          "error": "a lead creates an item, with --done_when"
        },
        {
          "id": 3,
          "when": {
            "changed": "status"
          },
          "require": {
            "in": [
              {
                "cat": [
                  {
                    "var": "prev.status"
                  },
                  ">",
                  {
                    "var": "next.status"
                  }
                ]
              },
              [
                "new>ready",
                "ready>active",
                "active>review",
                "review>active",
                "review>second-review",
                "second-review>active",
                "second-review>closed",
                "active>waiting",
                "waiting>active"
              ]
            ]
          },
          "error": "status does not move from {prev.status} to {next.status}"
        },
        {
          "id": 4,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "in": [
                  {
                    "var": "next.status"
                  },
                  [
                    "ready",
                    "closed"
                  ]
                ]
              }
            ]
          },
          "require": {
            "in": [
              "lead",
              {
                "var": "caller.roles"
              }
            ]
          },
          "error": "only a lead marks an item {next.status}"
        },
        {
          "id": 5,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "active"
                ]
              }
            ]
          },
          "require": {
            "and": [
              {
                "===": [
                  {
                    "var": "next.holder"
                  },
                  {
                    "var": "caller.name"
                  }
                ]
              },
              {
                "all": [
                  {
                    "map": [
                      {
                        "var": "next.depends_on"
                      },
                      {
                        "item": {
                          "var": ""
                        }
                      }
                    ]
                  },
                  {
                    "===": [
                      {
                        "var": "status"
                      },
                      "closed"
                    ]
                  }
                ]
              }
            ]
          },
          "error": "the holder makes item {next.seq} active, once its dependencies are closed"
        },
        {
          "id": 6,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "review"
                ]
              }
            ]
          },
          "require": {
            "and": [
              {
                "===": [
                  {
                    "var": "caller.name"
                  },
                  {
                    "var": "next.holder"
                  }
                ]
              },
              {
                "!!": {
                  "var": "next.result"
                }
              },
              {
                "in": [
                  "reviewer",
                  {
                    "roles_of": {
                      "var": "next.reviewer"
                    }
                  }
                ]
              }
            ]
          },
          "error": "the holder asks for review with a result and a reviewer"
        },
        {
          "id": 7,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "second-review"
                ]
              }
            ]
          },
          "require": {
            "and": [
              {
                "===": [
                  {
                    "var": "caller.name"
                  },
                  {
                    "var": "prev.reviewer"
                  }
                ]
              },
              {
                "in": [
                  "outside-reviewer",
                  {
                    "roles_of": {
                      "var": "next.reviewer"
                    }
                  }
                ]
              },
              {
                "===": [
                  {
                    "var": "next.review_passes"
                  },
                  {
                    "+": [
                      {
                        "var": "prev.review_passes"
                      },
                      1
                    ]
                  }
                ]
              }
            ]
          },
          "error": "the reviewer passes the item to an outside reviewer and counts the pass"
        },
        {
          "id": 8,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "closed"
                ]
              }
            ]
          },
          "require": {
            ">=": [
              {
                "var": "next.review_passes"
              },
              2
            ]
          },
          "error": "an item closes after two reviews (passed {next.review_passes})"
        },
        {
          "id": 9,
          "when": {
            "changed": "review_passes"
          },
          "require": {
            "and": [
              {
                "in": [
                  {
                    "var": "next.status"
                  },
                  [
                    "second-review",
                    "closed"
                  ]
                ]
              },
              {
                "===": [
                  {
                    "var": "next.review_passes"
                  },
                  {
                    "+": [
                      {
                        "var": "prev.review_passes"
                      },
                      1
                    ]
                  }
                ]
              }
            ]
          },
          "error": "review passes rise by one, when a review is passed"
        },
        {
          "id": 10,
          "when": {
            "and": [
              {
                "changed": "holder"
              },
              {
                "!!": {
                  "var": "prev.holder"
                }
              }
            ]
          },
          "require": {
            "and": [
              {
                "===": [
                  {
                    "var": "caller.name"
                  },
                  {
                    "var": "prev.holder"
                  }
                ]
              },
              {
                "in": [
                  "member",
                  {
                    "roles_of": {
                      "var": "next.holder"
                    }
                  }
                ]
              }
            ]
          },
          "error": "only the holder hands an item to another member"
        },
        {
          "id": 11,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "next.status"
                  },
                  "waiting"
                ]
              }
            ]
          },
          "require": {
            "!!": {
              "var": "next.question"
            }
          },
          "error": "an item waits with the question it waits for"
        },
        {
          "id": 12,
          "when": {
            "and": [
              {
                "changed": "status"
              },
              {
                "===": [
                  {
                    "var": "prev.status"
                  },
                  "waiting"
                ]
              }
            ]
          },
          "require": {
            "in": [
              "lead",
              {
                "var": "caller.roles"
              }
            ]
          },
          "error": "only a lead answers the question of a waiting item"
        },
        {
          "id": 13,
          "require": {
            "<=": [
              {
                "var": "next.estimate"
              },
              90
            ]
          },
          "error": "an item is at most 90 minutes (got {next.estimate})"
        },
        {
          "id": 14,
          "when": {
            "===": [
              {
                "var": "command"
              },
              "archive"
            ]
          },
          "require": {
            "===": [
              {
                "var": "next.status"
              },
              "closed"
            ]
          },
          "error": "only a closed item is archived"
        }
      ],
      "queue": [
        {
          "roles": [
            "reviewer",
            "outside-reviewer"
          ],
          "description": "a reviewer's items first",
          "match": {
            "and": [
              {
                "in": [
                  {
                    "var": "status"
                  },
                  [
                    "review",
                    "second-review"
                  ]
                ]
              },
              {
                "===": [
                  {
                    "var": "reviewer"
                  },
                  {
                    "outer": "caller.name"
                  }
                ]
              }
            ]
          }
        },
        {
          "roles": [
            "member"
          ],
          "description": "a member takes ready work",
          "match": {
            "===": [
              {
                "var": "status"
              },
              "ready"
            ]
          },
          "take": {
            "holder": "$caller",
            "status": "active"
          }
        },
        {
          "roles": [
            "lead"
          ],
          "description": "the lead answers waiting items, then readies new ones",
          "match": {
            "in": [
              {
                "var": "status"
              },
              [
                "waiting",
                "new"
              ]
            ]
          }
        }
      ],
      "filters": {
        "decisions": {
          "description": "Items waiting for the lead.",
          "match": {
            "===": [
              {
                "var": "status"
              },
              "waiting"
            ]
          }
        },
        "in-review": {
          "description": "Items in either review.",
          "match": {
            "in": [
              {
                "var": "status"
              },
              [
                "review",
                "second-review"
              ]
            ]
          }
        }
      }
    }
  }
}