{
  "schema": "backlog-team-behaviour/2",
  "workflow": "minimal",
  "description": "The smallest valid team behaviour: members claim a ready item and close it; nothing else is enforced.",
  "statuses": [
    "ready",
    "in progress",
    "closed",
    "archived"
  ],
  "initial": "ready",
  "finished": [
    "closed",
    "archived"
  ],
  "roles": {
    "lead": {
      "entry_person": "lead"
    },
    "member": {
      "entry_list": "members"
    },
    "holder": {
      "item_field": "claimed_by"
    }
  },
  "entry_constraints": [
    {
      "non_empty": "members"
    }
  ],
  "steps": {
    "claim": {
      "value": "agent",
      "actor": "flag_value",
      "from": [
        "ready"
      ],
      "to": "in progress",
      "by": [
        "member",
        "lead"
      ],
      "requires": [
        {
          "field_empty_or_actor": "claimed_by",
          "refusal": "claimed_by_other"
        }
      ],
      "sets": {
        "claimed_by": "actor",
        "claimed_at": "now"
      }
    },
    "close": {
      "value": "none",
      "actor": "by_or_holder",
      "from": [
        "in progress"
      ],
      "to": "closed",
      "by": [
        "holder",
        "lead"
      ],
      "arguments": {
        "summary": {
          "required": true,
          "refusal": "missing_argument"
        }
      },
      "records": "## Closed by <actor> at <now>\n\n<summary>"
    }
  },
  "undefined_step_refusals": {
    "status": "status_flag"
  },
  "user_commands": {
    "update": {
      "allow": false,
      "refusal": "user_update"
    },
    "update-replan": {
      "allow": true
    },
    "done": {
      "allow": false,
      "refusal": "user_update"
    },
    "archive-unfinished": {
      "allow": false,
      "refusal": "user_update"
    },
    "archive-finished": {
      "allow": true
    },
    "archive-done": {
      "allow": true
    },
    "move-branch": {
      "allow": true
    },
    "move-repository": {
      "allow": true
    },
    "import": {
      "allow": true
    },
    "import-higher": {
      "allow": true
    },
    "clean": {
      "allow": false,
      "refusal": "user_update"
    },
    "new-split-from": {
      "allow": false,
      "refusal": "user_update"
    }
  },
  "refusals": {
    "wrong_status": "<item> is <status>; <step> needs <from>",
    "wrong_actor": "<step> on <item> is for <who>, not <actor>",
    "missing_argument": "<step> needs --<argument>",
    "step_not_defined": "<step> is not a step of workflow <workflow> (team <team>)",
    "status_flag": "backlog team update takes no --status: the status of a team item moves by its steps",
    "one_step": "one team-work step at a time (got <flags>)",
    "empty_flag_value": "<item>: --<step> needs a value",
    "not_team_item": "<item> belongs to no team: use backlog update, or bind it with --set-team",
    "other_team": "the item belongs to team <item_team>, not to this session's team <team>",
    "claimed_by_other": "<item>: claimed by <holder> since <claimed_at>",
    "user_update": "use backlog team update: <item> belongs to team <item_team>",
    "create_status_flag": "backlog team new takes no --status: a new item of team <team> starts with the initial status of its workflow"
  }
}
