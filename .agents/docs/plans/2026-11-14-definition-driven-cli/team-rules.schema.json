{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmoothSDLC/smooth-backlog-cli/team-rules.schema.json",
  "title": "Rule set of a team",
  "description": "The rules of one team (team-rules-spec.md). Every rule is evaluated on every change a team command makes; all must hold.",
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "description": "The team's way of working in words."
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match": {
            "$ref": "#/$defs/condition"
          },
          "take": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "match"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "match": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "description": "A JsonLogic expression (team-rules-spec.md, section 6), or a literal true or false.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "var",
              "missing",
              "missing_some",
              "if",
              "==",
              "===",
              "!=",
              "!==",
              "!",
              "!!",
              "or",
              "and",
              ">",
              ">=",
              "<",
              "<=",
              "in",
              "cat",
              "substr",
              "+",
              "-",
              "*",
              "/",
              "%",
              "min",
              "max",
              "map",
              "filter",
              "reduce",
              "all",
              "some",
              "none",
              "merge",
              "changed",
              "item",
              "length",
              "roles_of",
              "regex",
              "age",
              "outer"
            ]
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "require",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "description": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "require": {
          "$ref": "#/$defs/condition"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}