{
  "default": {
    "description": "One or more agents; status new, active, closed.",
    "people": {
      "agent-1": [
        "member"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "new",
        "values": [
          "new",
          "active",
          "closed"
        ],
        "final": [
          "closed"
        ],
        "description": "Where the item is."
      }
    },
    "rules": {
      "description": "Only people of the team change items. Status moves new to active to closed. Only a closed item is archived.",
      "rules": [
        {
          "id": 1,
          "require": {
            "not": {
              "empty": "$caller.roles"
            }
          },
          "message": "{$caller} is not a person of team {$team.name}"
        },
        {
          "id": 2,
          "on": {
            "changes": [
              "status"
            ]
          },
          "require": {
            "in": [
              {
                "text": "{$before.status}>{$after.status}"
              },
              [
                "new>active",
                "active>closed"
              ]
            ]
          },
          "message": "status does not move from {$before.status} to {$after.status}"
        },
        {
          "id": 3,
          "on": {
            "commands": [
              "archive"
            ]
          },
          "require": {
            "is": [
              "$after.status",
              "closed"
            ]
          },
          "message": "only a closed item is archived"
        }
      ],
      "queue": [
        {
          "match": {
            "is": [
              "$it.status",
              "new"
            ]
          },
          "take": {
            "status": "active"
          }
        }
      ],
      "filters": {
        "active": {
          "description": "Items being worked on.",
          "match": {
            "is": [
              "$it.status",
              "active"
            ]
          }
        }
      }
    }
  }
}