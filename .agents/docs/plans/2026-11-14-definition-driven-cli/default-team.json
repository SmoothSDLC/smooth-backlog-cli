{
  "default": {
    "description": "One or more agents; status new, active, closed.",
    "people": {
      "agent-1": [
        "member"
      ]
    },
    "item": {
      "status": {
        "type": "text",
        "default": "new",
        "values": [
          "new",
          "active",
          "closed"
        ],
        "final": [
          "closed"
        ],
        "description": "Where the item is."
      }
    },
    "rules": {
      "description": "Only people of the team change items. Status moves new to active to closed. Only a closed item is archived.",
      "rules": [
        {
          "id": 1,
          "require": {
            "!!": {
              "var": "caller.roles"
            }
          },
          "error": "{caller.name} is not a person of team {team.name}"
        },
        {
          "id": 2,
          "when": {
            "changed": "status"
          },
          "require": {
            "in": [
              {
                "cat": [
                  {
                    "var": "prev.status"
                  },
                  ">",
                  {
                    "var": "next.status"
                  }
                ]
              },
              [
                "new>active",
                "active>closed"
              ]
            ]
          },
          "error": "status does not move from {prev.status} to {next.status}"
        },
        {
          "id": 3,
          "when": {
            "===": [
              {
                "var": "command"
              },
              "archive"
            ]
          },
          "require": {
            "===": [
              {
                "var": "next.status"
              },
              "closed"
            ]
          },
          "error": "only a closed item is archived"
        }
      ],
      "queue": [
        {
          "match": {
            "===": [
              {
                "var": "status"
              },
              "new"
            ]
          },
          "take": {
            "status": "active"
          }
        }
      ],
      "filters": {
        "active": {
          "description": "Items being worked on.",
          "match": {
            "===": [
              {
                "var": "status"
              },
              "active"
            ]
          }
        }
      }
    }
  }
}